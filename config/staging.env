# -----------------------------------------------------------------------------
#  config/staging.env
#  Staging environment configuration. Use with: TEST_ENV=staging npm run test
#  Demo targets: SauceDemo (UI) + JSONPlaceholder (API). Swap these URLs for
#  your own staging environment when adopting this framework.
# -----------------------------------------------------------------------------

TEST_ENV=staging
BASE_URL=https://www.saucedemo.com/
API_BASE_URL=https://jsonplaceholder.typicode.com/
USERNAME=standard_user
PASSWORD=secret_sauce
HEADLESS=true
LOG_LEVEL=info