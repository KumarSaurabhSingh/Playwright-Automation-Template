# -----------------------------------------------------------------------------
#  config/prod.env
#  Production environment configuration. Use with: TEST_ENV=prod npm run test
#  WARNING: real production credentials should NEVER live in this file.
#  Inject secrets via CI secrets / environment variables instead.
#  Demo targets: SauceDemo (UI) + JSONPlaceholder (API).
# -----------------------------------------------------------------------------

TEST_ENV=prod
BASE_URL=https://www.saucedemo.com/
API_BASE_URL=https://jsonplaceholder.typicode.com/
USERNAME=standard_user
PASSWORD=secret_sauce
HEADLESS=true
LOG_LEVEL=info