# =============================================================================
#  .env.example
#  Template for local environment variables. Copy to `.env` and fill real values.
#  NEVER commit real credentials — keep this file with placeholders only.
#
#  Environment-specific values live in config/<env>.env (e.g. config/dev.env).
#  Use TEST_ENV to switch:  TEST_ENV=staging npm run test:e2e
# =============================================================================

# The default environment to run against when TEST_ENV is not set.
TEST_ENV=dev

# Base URL of the application under test (used by tests and Playwright baseURL).
# Demo app: SauceDemo (https://www.saucedemo.com). Swap for your own app.
BASE_URL=https://www.saucedemo.com/

# Login credentials used by the UI example tests.
# Demo app credentials: standard_user / secret_sauce.
USERNAME=standard_user
PASSWORD=secret_sauce

# UI runtime behaviour.
HEADLESS=true
LOG_LEVEL=info

# API endpoint used by the API test examples (leave empty to reuse BASE_URL).
# Demo API: JSONPlaceholder (https://jsonplaceholder.typicode.com).
API_BASE_URL=https://jsonplaceholder.typicode.com/

# -----------------------------------------------------------------------------
# Email report (npm run email:report / CI notify job).
# Uses SummaryReporter output (reports/test-summary.json). In CI these come from
# GitHub Actions secrets; locally you can put real values in `.env`.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@example.com
SMTP_PASS=your-app-password
MAIL_FROM=your.address@example.com
MAIL_TO=team.member1@example.com,team.member2@example.com
# Set to true to preview the email in the terminal without sending it.
EMAIL_DRY_RUN=false