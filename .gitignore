# -----------------------------------------------------------------------------
#  .gitignore
#  Files and folders that must NEVER be committed to version control.
# -----------------------------------------------------------------------------

# Node dependencies
node_modules/

# Playwright runtime artifacts
test-results/
playwright-report/
reports/
allure-results/
allure-report/

# Logs
logs/
*.log

# Local environment secrets — never commit real credentials
.env
*.env.local
.env.*.local
!config/*.env

# Build output
dist/
build/

# Editor / OS files
.vscode/
.idea/
.DS_Store
*.swp
